{
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/target",
    "**/dist",
    "extension/artifacts",
    "macos/build",
    "macos/Frameworks",
    "macos/GeneratedBindings",
    "macos/Cuttings.xcodeproj",
    "**/xcuserdata",
