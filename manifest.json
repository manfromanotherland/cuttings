{
  "manifest_version": 3,
  "name": "read-later",
  "version": "0.1.0",
  "description": "Save pages to read later, locally.",
  "permissions": ["activeTab", "nativeMessaging", "contextMenus", "notifications", "storage"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Save to Read Later"
  },
  "options_page": "options.html",
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Save current page to Read Later"
    }
  }
}
