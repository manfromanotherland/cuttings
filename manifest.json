{
  "manifest_version": 3,
  "name": "ReadControl",
  "version": "0.1.0",
  "description": "Save pages to read later, locally.",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "read-control@readcontrol.app",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "contextMenus",
    "notifications",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "scripts": ["dist/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save to ReadControl",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Save current page to ReadControl"
    }
  }
}
